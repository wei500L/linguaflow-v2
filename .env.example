NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://linguaflow:linguaflow@localhost:5432/linguaflow
JWT_SECRET=replace-with-a-long-random-value
SONIOX_API_KEY=
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LinguaFlow <no-reply@example.com>
ADMIN_EMAIL=admin@example.com
VITE_API_URL=http://localhost:3000
RECORDINGS_DIR=data/recordings
PDF_FONT_PATH=
# Optional. Falls back to JWT_SECRET. Rotating JWT_SECRET makes saved summary keys unreadable unless this is set.
SETTINGS_ENCRYPTION_KEY=
# Optional platform summary model. All three are required before users can spend quota on it.
PLATFORM_SUMMARY_API_BASE=
PLATFORM_SUMMARY_API_KEY=
PLATFORM_SUMMARY_MODEL=

# NODE_ENV=production requires non-empty JWT_SECRET, SONIOX_API_KEY and ADMIN_EMAIL.
# SMTP is optional. BOOTSTRAP_EMAIL and BOOTSTRAP_PASSWORD create an unlimited Ultra owner.
